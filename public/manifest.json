{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "author": {
    "email": "timeshield@example.com"
  },
  "icons": {
    "16": "shield.png",
    "48": "shield.png",
    "128": "shield.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "shield.png",
      "48": "shield.png",
      "128": "shield.png"
    }
  },
  "options_page": "src/options/index.html",
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "windows", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "homepage_url": "https://github.com/VASHvic/time-shield",
  "minimum_chrome_version": "88",
  "offline_enabled": true
}
